# ĐỒNG BỘ TỪ joblens/docs/project-plan/templates/env.example – sửa ở đó trước, không sửa tại đây
# Bộ biến môi trường chung cho 4 repo JobLens (docs/09, quy tắc 7).
# Chép thành .env rồi sửa giá trị theo máy mình. KHÔNG commit .env.
# Giá trị dưới đây là mẫu cho môi trường local (k3d port-forward), không phải bí mật.

# Địa chỉ Kafka (bootstrap servers)
JOBLENS_KAFKA_BOOTSTRAP=localhost:9092

# Object storage S3 (SeaweedFS)
JOBLENS_S3_ENDPOINT=http://localhost:8333
JOBLENS_S3_BUCKET=joblens

# Iceberg REST catalog (Lakekeeper)
JOBLENS_CATALOG_URI=http://localhost:8181/catalog

# Trino
JOBLENS_TRINO_URL=http://localhost:8080

# local | k8s
JOBLENS_ENV=local
