    },
    {
      "type": "timeseries",
      "title": "Tin mới theo tỉnh – cửa sổ 5 phút (streaming có trạng thái → MongoDB)",
      "description": "stream_province_windows.py: window(crawl_ts, 5 phút) + watermark 10 phút, output mode update, upsert MongoDB. Tên tỉnh lấy từ bảng Iceberg gold.dim_location (join liên nguồn).",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT w.window_start AS time, d.name AS metric, w.postings AS value\nFROM (SELECT window_start, location_code, postings, to_unixtime(window_start) AS ws_epoch\n      FROM mongodb.joblens.province_windows) w\nJOIN iceberg.gold.dim_location d ON d.location_code = w.location_code\nWHERE $__unixEpochFilter(w.ws_epoch)\nORDER BY 1",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 102,
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "table",
      "title": "Lần chạy spark_analytics gần nhất (MLlib, kế hoạch thực thi)",
      "description": "analytics_spark.py ghi vào MongoDB analytics_runs. RMSE theo triệu VND trên tập kiểm tra; so với mô hình luôn đoán trung vị.",
      "gridPos": {
        "x": 16,
        "y": 37,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT run_at AS luc_chay,\n       round(model.test_rmse_million_vnd, 2) AS rmse_mo_hinh_trieu,\n       round(model.baseline_median_rmse_million_vnd, 2) AS rmse_doan_trung_vi_trieu,\n       round(model.test_r2_log, 3) AS r2_log,\n       plan_checks.broadcast_join AS broadcast_join,\n       plan_checks.sort_merge_join AS sort_merge_join,\n       plan_checks.bronze_filter_pushed AS partition_pruning\nFROM mongodb.joblens.analytics_runs ORDER BY run_at DESC LIMIT 5",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 103,
