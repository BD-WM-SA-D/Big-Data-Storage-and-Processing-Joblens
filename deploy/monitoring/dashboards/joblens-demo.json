          "rawSQL": "SELECT 'bronze.jobs_raw' AS bang, count(*) AS so_file, round(avg(file_size_in_bytes) / 1024.0, 1) AS kb_trung_binh, sum(record_count) AS so_dong FROM iceberg.bronze.\"jobs_raw$files\"\nUNION ALL\nSELECT 'silver.job_postings', count(*), round(avg(file_size_in_bytes) / 1024.0, 1), sum(record_count) FROM iceberg.silver.\"job_postings$files\"\nUNION ALL\nSELECT 'silver.job_postings_snapshot', count(*), round(avg(file_size_in_bytes) / 1024.0, 1), sum(record_count) FROM iceberg.silver.\"job_postings_snapshot$files\"",
