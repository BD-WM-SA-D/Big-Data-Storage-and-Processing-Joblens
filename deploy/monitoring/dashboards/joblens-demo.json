    {
      "id": 7,
      "type": "timeseries",
      "title": "Tin nạp vào bronze theo 10 giây (theo topic)",
      "description": "jobs.raw.*.v1 = đường streaming (Kafka → Spark), backfill.vietjobs = đường batch. Lọc theo epoch giây nên không phụ thuộc múi giờ phiên Trino.",
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT $__timeGroup(ingest_ts, '10s') AS time, kafka_topic AS metric, count(*) AS value\nFROM (SELECT ingest_ts, kafka_topic, to_unixtime(ingest_ts) AS ingest_epoch FROM iceberg.bronze.jobs_raw)\nWHERE $__unixEpochFilter(ingest_epoch)\nGROUP BY 1, 2\nORDER BY 1",
          "format": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
