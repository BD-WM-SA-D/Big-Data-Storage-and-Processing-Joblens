# Image mô hình của Web Mining mà DAG gọi (ADR 0001 D3) – phiên bản pin, không dùng latest.
# Repo này KHÔNG chứa code mô hình: install.sh clone repo WM đúng commit WM_REF và build bằng Dockerfile của WM.
# Tag = <phiên bản mô hình>-<commit WM rút gọn>[-stub]; phiên bản lấy theo models.yaml của WM.
# Đổi WM_REF khi WM báo commit/tag mới (issue cross-repo #2), rồi chạy lại: bash deploy/mining/install.sh
WM_REPO=https://github.com/BD-WM-SA-D/Web-mining-joblens.git
WM_REF=13dbe7a
SKILL_EXTRACTOR_VERSION=0.2.0
JOB_DEDUP_VERSION=0.1.0
ABSA_SCORER_VERSION=0.1.0
