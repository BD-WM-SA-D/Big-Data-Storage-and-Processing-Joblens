{
  // Môi trường GitHub Codespaces cho demo trên cloud (docs/cloud-codespaces.md).
  // Máy 4 nhân / 16 GB: đủ chạy toàn bộ nền tảng (profile full, cụm k3d một node để tiết kiệm đĩa).
  // Công cụ (k3d, kubectl, helm, uv) cài theo phiên bản cố định ở post-create.sh – không dùng latest.
  "name": "JobLens Big Data (k3d)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "containerEnv": { "JOBLENS_PROFILE": "full", "K3D_AGENTS": "0" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 8081, 8082, 8080, 8181, 8888, 4040],
  "portsAttributes": {
    "3000": { "label": "Grafana" },
    "8081": { "label": "Kafka UI" },
    "8082": { "label": "Airflow" },
    "8080": { "label": "Trino" },
    "8181": { "label": "Lakekeeper" },
    "8888": { "label": "SeaweedFS" },
    "4040": { "label": "Spark UI" }
  }
}
